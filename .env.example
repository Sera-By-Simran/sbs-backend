# SÉRA BY SIMRAN — Backend Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.

APP_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3001

# Supabase (Exclusive Service-Role Owner)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Internal Secrets (Auto-generated by node scripts/setup-init.js)
INTERNAL_API_KEY=
REVALIDATE_SECRET=
CRON_SECRET=
IP_HASH_SALT=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=SÉRA BY SIMRAN <hello@serabysimran.in>
ENQUIRY_NOTIFY_EMAIL=

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bot Protection
TURNSTILE_SECRET_KEY=

# Initial Owner Bootstrap
BOOTSTRAP_OWNER_EMAIL=
